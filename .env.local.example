# Pipeline Trigger Token — used only to start a new pipeline run.
# Create one at: Project > Settings > CI/CD > Pipeline trigger tokens.
GITLAB_TRIGGER_TOKEN=

# Personal or project access token with `read_api` (or `api`) scope — used
# to poll pipeline/job status after triggering. A trigger token can't be
# used for this; it's a separate, more limited credential.
# Create one at: https://gitlab.com/-/user_settings/personal_access_tokens
GITLAB_TOKEN=

# The project to trigger pipelines for — either its numeric ID (e.g. "86")
# or URL-encoded path, e.g. "mygroup%2Fmyproject".
GITLAB_PROJECT_ID=

# Only needed for self-hosted GitLab instances. Defaults to https://gitlab.com.
# GITLAB_BASE_URL=https://gitlab.example.com

# Only needed if that self-hosted instance's TLS cert is signed by a
# corporate/internal CA that Node doesn't trust by default. Path to a PEM
# file containing that CA's certificate (not the server's own cert).
# GITLAB_CA_CERT_PATH=/path/to/corporate-ca.pem

# Set to "true" to bypass the real GitLab API entirely and use an in-memory
# fake pipeline (progresses through jobs over ~15s). Useful for trying out
# the UI without real tokens/project. GITLAB_TRIGGER_TOKEN/GITLAB_TOKEN/
# GITLAB_PROJECT_ID are ignored when this is on.
GITLAB_MOCK=false
